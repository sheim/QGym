    <visual>
        <geometry>
            <mesh filename="meshes/mini_vision_upper_leg.dae"/>
        </geometry>
        <origin rpy="0.0 0 3.141592" xyz="0.0 0.0 0.0"/>
    </visual>
    <collision>
        <geometry><cylinder length ="0.17" radius = "0.015"/></geometry>
        <origin rpy="0 0 0" xyz="0 0.05 -0.092"/>
    </collision>
</link>

