<?xml version="1.0"?>
<robot name="mini_horse">

  <!-- ===================== BODY ===================== -->
  <link name="base_fh">
    <visual><origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="1.02 0.38 0.61"/>
      </geometry>
      <material name="brown">
        <color rgba="0.5 0.3 0.2 0.5"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="1.02 0.38 0.61"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="345.0"/>
      <inertia ixx="1.0" iyy="1.0" izz="1.0" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

    <link name="base_bh">
    <visual>
      <origin xyz="-0.27 0 -0.3" rpy="0 0 0"/>
      <geometry>
        <box size="0.51 0.38 0.61"/>
      </geometry>
      <material name="brown">
        <color rgba="0.5 0.3 0.2 0.5"/>
      </material>
    </visual>
    <collision>
      <origin xyz="-0.27 0 -0.3" rpy="0 0 0"/>
      <geometry>
        <box size="0.51 0.38 0.61"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="145.0"/>
      <inertia ixx="1.0" iyy="1.0" izz="1.0" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="base_joint" type="revolute">
    <parent link="base_fh"/><child link="base_bh"/>
    <origin xyz="-0.5 0 0.3" rpy="0 0 0"/><axis xyz="0 1 0"/>
    <limit effort="18" lower="0" upper="0.2" velocity="41"/>
  </joint>

  <!-- ===================== LEG TEMPLATE ========================== -->
  <!-- Five links per leg: shoulder -> hip -> thigh -> shank -> hoof -->
  <!-- ===================== FRONT LEFT LEG ======================== -->
  <link name="FL_shoulder">
    <visual><origin xyz="0.0 0.0 0.0" rpy="1.5708 0 0"/><geometry><cylinder length="0.05" radius="0.075"/></geometry></visual>
    <inertial><mass value="2.0"/><inertia ixx="0.02" iyy="0.02" izz="0.01"/></inertial>
  </link>
  <link name="FL_hip">
    <visual><origin xyz="0.0 0.1 -0.25"/><geometry><cylinder length="0.46" radius="0.075"/></geometry></visual>
    <collision><origin xyz="0.0 0.1 -0.25"/><geometry><box size="0.15 0.15 0.4"/></geometry></collision>
    <inertial><mass value="2.0"/><inertia ixx="0.02" iyy="0.02" izz="0.01"/></inertial>
  </link>
  <link name="FL_thigh">
    <visual><origin xyz="0.04 0.1 -0.15"/><geometry><cylinder length="0.3" radius="0.04"/></geometry></visual>
    <collision><origin xyz="0.04 0.1 -0.15"/><geometry><box size="0.08 0.08 0.25"/></geometry></collision>
    <inertial><mass value="3.0"/><inertia ixx="0.03" iyy="0.03" izz="0.01"/></inertial>
  </link>
  <link name="FL_shank">
    <visual><origin xyz="0.0 0.1 -0.045"/><geometry><cylinder length="0.13" radius="0.03"/></geometry></visual>
    <collision><origin xyz="0.0 0.1 -0.045"/><geometry><box size="0.06 0.06 0.1"/></geometry></collision>
    <inertial><mass value="2.5"/><inertia ixx="0.02" iyy="0.02" izz="0.01"/></inertial>
  </link>
  <link name="FL_hoof">
    <visual><origin xyz="0.0 0.1 -0.05"/><geometry><cylinder length="0.08" radius="0.05"/></geometry></visual>
    <collision><origin xyz="0.0 0.1 -0.055"/><geometry><box size="0.1 0.1 0.07"/></geometry></collision>
    <inertial><mass value="1.0"/><inertia ixx="0.01" iyy="0.01" izz="0.01"/></inertial>
  </link>

  <joint name="2_fl_haa" type="revolute">
    <parent link="base_fh"/><child link="FL_shoulder"/>
    <origin xyz="0.35 0.225 -0.23" rpy="0 0 0"/><axis xyz="1 0 0"/>
    <limit effort="18" lower="-0.2" upper="0.2" velocity="41"/>
  </joint>
  <joint name="FL_hip_joint" type="revolute">
    <parent link="FL_shoulder"/><child link="FL_hip"/>
    <origin xyz="0 0 0.025" rpy="0 0 0"/><axis xyz="0 1 0"/>
    <limit lower="-1.7" upper="0.5" effort="50" velocity="2.0"/>
  </joint>
  <joint name="FL_knee_joint" type="revolute">
    <parent link="FL_hip"/><child link="FL_thigh"/>
    <origin xyz="-0.08 0 -0.48"/><axis xyz="0 1 0"/>
    <limit lower="0" upper="3.0" effort="40" velocity="2.0"/>
  </joint>
  <joint name="FL_fetlock_joint" type="revolute">
    <parent link="FL_thigh"/><child link="FL_shank"/>
    <origin xyz="0.04 0 -0.32"/><axis xyz="0 1 0"/>
    <limit lower="-1.2" upper="0.5" effort="30" velocity="2.0"/>
  </joint>
  <joint name="FL_hoof_joint" type="revolute">
    <parent link="FL_shank"/><child link="FL_hoof"/>
    <origin xyz="0 0 -0.1"/><axis xyz="0 1 0"/>
    <limit lower="-0.3" upper="1.2" effort="20" velocity="2.0"/>
  </joint>

  <!-- ===================== FRONT RIGHT LEG ===================== -->
  <link name="FR_shoulder">
    <visual><origin xyz="0.0 0.0 0.0" rpy="1.5708 0 0"/><geometry><cylinder length="0.05" radius="0.075"/></geometry></visual>
    <inertial><mass value="2.0"/><inertia ixx="0.02" iyy="0.02" izz="0.01"/></inertial>
  </link>
  <link name="FR_hip">
    <visual><origin xyz="0.0 0.1 -0.25"/><geometry><cylinder length="0.46" radius="0.075"/></geometry></visual>
    <collision><origin xyz="0.0 0.1 -0.25"/><geometry><box size="0.15 0.15 0.4"/></geometry></collision>
    <inertial><mass value="2.0"/><inertia ixx="0.02" iyy="0.02" izz="0.01"/></inertial>
  </link>
  <link name="FR_thigh">
    <visual><origin xyz="0.04 0.1 -0.15"/><geometry><cylinder length="0.3" radius="0.04"/></geometry></visual>
