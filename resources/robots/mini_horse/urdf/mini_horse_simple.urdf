    <origin xyz="0 0 -0.1"/><axis xyz="0 1 0"/>
    <limit lower="-0.3" upper="1.2" effort="20" velocity="2.0"/>
  </joint>

  <!-- ===================== RIGHT FRONT LEG ===================== -->
