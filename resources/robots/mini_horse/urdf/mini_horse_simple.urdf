  </joint>
  <joint name="FR_hoof_joint" type="revolute">
    <parent link="FR_shank"/><child link="FR_hoof"/>
    <origin xyz="0 0 -0.1"/><axis xyz="0 1 0"/>
    <limit lower="-0.3" upper="1.2" effort="20" velocity="2.0"/>
  </joint>

  <!-- ===================== REAR LEFT LEG ===================== -->
  <link name="RL_shoulder">
    <visual><origin xyz="0.0 0.0 0.0" rpy="1.5708 0 0"/><geometry><cylinder length="0.05" radius="0.075"/></geometry></visual>
    <inertial><mass value="2.0"/><inertia ixx="0.02" iyy="0.02" izz="0.01"/></inertial>
  </link>
  <link name="RL_hip">
    <visual><origin xyz="0.0 0.0 -0.17"/><geometry><cylinder length="0.46" radius="0.09"/></geometry></visual>
    <collision><origin xyz="0.0 0.0 -0.17"/><geometry><box size="0.175 0.175 0.4"/></geometry></collision>
    <inertial><mass value="2.0"/><inertia ixx="0.02" iyy="0.02" izz="0.01"/></inertial>
  </link>
  <link name="RL_thigh">
    <visual><origin xyz="-0.05 0 -0.185"/><geometry><cylinder length="0.36" radius="0.05"/></geometry></visual>
    <collision><origin xyz="-0.05 0 -0.185"/><geometry><box size="0.1 0.1 0.3"/></geometry></collision>
    <inertial><mass value="3.0"/><inertia ixx="0.03" iyy="0.03" izz="0.01"/></inertial>
  </link>
  <link name="RL_shank">
    <visual><origin xyz="0 0 -0.09"/><geometry><cylinder length="0.15" radius="0.03"/></geometry></visual>
    <collision><origin xyz="0 0 -0.09"/><geometry><box size="0.06 0.06 0.12"/></geometry></collision>
    <inertial><mass value="2.5"/><inertia ixx="0.02" iyy="0.02" izz="0.01"/></inertial>
  </link>
  <link name="RL_hoof"><visual><origin xyz="0 0 -0.05"/><geometry><cylinder length="0.1" radius="0.05"/></geometry></visual>
    <collision><origin xyz="0 0 -0.055"/><geometry><box size="0.1 0.1 0.09"/></geometry></collision>
    <inertial><mass value="1.0"/><inertia ixx="0.01" iyy="0.01" izz="0.01"/></inertial>
  </link>

  <joint name="2_rf_haa" type="revolute">
    <parent link="base_bh"/><child link="RL_shoulder"/>
    <origin xyz="-0.3 0.225 -0.43" rpy="0 0 0"/><axis xyz="1 0 0"/>
    <limit effort="18" lower="-0.2" upper="0.2" velocity="41"/>
  </joint>
  <joint name="RL_hip_joint" type="revolute">
    <parent link="RL_shoulder"/><child link="RL_hip"/>
    <origin xyz="0 0.12 -0.05" rpy="0 0 0"/><axis xyz="0 1 0"/>
    <limit lower="-0.5" upper="1.5" effort="50" velocity="2.0"/>
  </joint>
  <joint name="RL_knee_joint" type="revolute">
    <parent link="RL_hip"/><child link="RL_thigh"/>
    <origin xyz="0.09 0 -0.4"/><axis xyz="0 1 0"/>
    <limit lower="-3.0" upper="0.0" effort="40" velocity="2.0"/>
  </joint>
  <joint name="RL_fetlock_joint" type="revolute">
    <parent link="RL_thigh"/><child link="RL_shank"/>
    <origin xyz="-0.04 0 -0.35"/><axis xyz="0 1 0"/>
    <limit lower="-1.0" upper="0.0" effort="30" velocity="2.0"/>
  </joint>
  <joint name="RL_hoof_joint" type="revolute">
    <parent link="RL_shank"/><child link="RL_hoof"/>
    <origin xyz="0 0 -0.16"/><axis xyz="0 1 0"/>
    <limit lower="-0.3" upper="1.5" effort="20" velocity="2.0"/>
  </joint>

  <!-- ===================== REAR RIGHT LEG ===================== -->
  <link name="RR_shoulder">
    <visual><origin xyz="0.0 0.0 0.0" rpy="1.5708 0 0"/><geometry><cylinder length="0.05" radius="0.075"/></geometry></visual>
    <inertial><mass value="2.0"/><inertia ixx="0.02" iyy="0.02" izz="0.01"/></inertial>
  </link>
  <link name="RR_hip">
    <visual><origin xyz="0.0 0.0 -0.17"/><geometry><cylinder length="0.46" radius="0.09"/></geometry></visual>
    <collision><origin xyz="0.0 0.0 -0.17"/><geometry><box size="0.175 0.175 0.4"/></geometry></collision>
    <inertial><mass value="2.0"/><inertia ixx="0.02" iyy="0.02" izz="0.01"/></inertial>
  </link>
  <link name="RR_thigh">
    <visual><origin xyz="-0.05 0 -0.185"/><geometry><cylinder length="0.36" radius="0.05"/></geometry></visual>
    <collision><origin xyz="-0.05 0 -0.185"/><geometry><box size="0.1 0.1 0.3"/></geometry></collision>
    <inertial><mass value="3.0"/><inertia ixx="0.03" iyy="0.03" izz="0.01"/></inertial>
  </link>
  <link name="RR_shank">
    <visual><origin xyz="0 0 -0.09"/><geometry><cylinder length="0.15" radius="0.03"/></geometry></visual>
    <collision><origin xyz="0 0 -0.09"/><geometry><box size="0.06 0.06 0.12"/></geometry></collision>
    <inertial><mass value="2.5"/><inertia ixx="0.02" iyy="0.02" izz="0.01"/></inertial>
  </link>
  <link name="RR_hoof"><visual><origin xyz="0 0 -0.05"/><geometry><cylinder length="0.1" radius="0.05"/></geometry></visual>
