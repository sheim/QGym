# Environment for running the vsim (vlearn) backend.
# Usage:  uv run --env-file .env.vsim scripts/train_mujoco.py --backend vsim ...
# All commands must run from the repo root (paths are relative to it).
#
# LD_LIBRARY_PATH must be set before the process starts — the loader resolves
# libgym.so's SONAME-less NEEDED entries at dlopen; in-process fixes cannot
# work.  The three VL_* vars point the engine at the vendored license pieces
# (see vendor/vlearn/README.md).
LD_LIBRARY_PATH=.venv/lib/python3.11/site-packages/vlearn/lib
VL_WORKING_DIRECTORY=vendor/vlearn
VL_TURBO_ACTIVATE_PATH=vendor/vlearn/TurboActivate.dat
VL_LICENSE_KEY_PATH=vendor/vlearn/License.key
# Viewer: force GL onto the NVIDIA GPU (PRIME render offload).  On hybrid
# AMD-iGPU + NVIDIA machines, GL otherwise lands on the iGPU while CUDA is
# on NVIDIA — vsim's GL/CUDA interop then poisons the CUDA context
# ("cudaErrorUnknown" on the next allocation).  Harmless for headless runs.
__NV_PRIME_RENDER_OFFLOAD=1
__GLX_VENDOR_LIBRARY_NAME=nvidia
